{
   "name": "react",
   "private": true,
   "version": "1.0.0",
   "type": "module",
   "homepage": "https://greyadmiral.github.io/Fake-Store/",
   "scripts": {
      "dev": "vite",
      "build": "tsc -b && vite build",
      "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
      "lint:fix": "eslint . --fix --color",
      "prettier": "prettier ./src --check",
      "prettier:fix": "prettier ./src --write",
      "format": "eslint . --fix --color && prettier ./src --write",
      "preview": "vite preview",
      "prepare": "husky .husky",
      "test": "vitest --config ./vite.testconfig.ts",
      "coverage": "vitest --coverage --config ./vite.testconfig.ts",
      "predeploy": "npm run build",
      "deploy": "gh-pages -d dist"
   },
   "dependencies": {
      "dompurify": "^3.4.1",
      "react": "^19.2.3",
      "react-dom": "^19.2.3",
      "react-lazy-load-image-component": "^1.6.3",
      "react-router": "^7.14.1"
   },
   "devDependencies": {
      "@axelrindle/vite-plugin-favicon": "^0.2.0",
      "@eslint/js": "^9.39.1",
      "@testing-library/jest-dom": "^6.9.1",
      "@testing-library/react": "^16.3.1",
      "@testing-library/user-event": "^14.6.1",
      "@types/estree": "^1.0.8",
      "@types/node": "^25.0.6",
      "@types/react": "^19.2.5",
      "@types/react-dom": "^19.2.3",
      "@types/react-lazy-load-image-component": "^1.6.5",
      "@typescript-eslint/eslint-plugin": "^8.46.2",
      "@vitejs/plugin-react": "^5.1.1",
      "@vitest/coverage-v8": "^4.0.16",
      "autoprefixer": "^10.4.21",
      "babel-plugin-react-compiler": "^1.0.0",
      "clsx": "^2.1.1",
      "eslint": "^9.39.2",
      "eslint-plugin-prettier": "^5.5.4",
      "eslint-plugin-react": "^7.37.5",
      "eslint-plugin-react-hooks": "^7.0.1",
      "eslint-plugin-react-refresh": "^0.4.26",
      "eslint-plugin-simple-import-sort": "^12.1.1",
      "gh-pages": "^6.3.0",
      "globals": "^16.5.0",
      "husky": "^9.1.7",
      "jsdom": "^27.4.0",
      "lint-staged": "^16.2.7",
      "postcss": "^8.5.6",
      "prettier": "^3.7.4",
      "sass": "^1.97.2",
      "typescript": "~5.9.3",
      "typescript-eslint": "^8.46.4",
      "vite": "^7.2.4",
      "vite-plugin-checker": "^0.12.0",
      "vite-plugin-clean": "^2.0.1",
      "vite-plugin-imagemin": "^0.6.1",
      "vite-plugin-webfont-dl": "^3.11.1",
      "vite-tsconfig-paths": "^6.0.4",
      "vitest": "^4.0.16"
   }
}
